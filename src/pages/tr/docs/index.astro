---
import CollectionLayout from "@components/docs/CollectionLayout.astro";
import { getIndex, getEntries } from "@lib/contentParser";
import type { DocsEntry } from "@/types";
import { sortByTitle } from "@lib/sortFunctions";

const collectionIndex = (await getIndex("docs")) as DocsEntry;
const allEntries = (await getEntries("docs", sortByTitle)) as DocsEntry[];

// TÜRKÇE FİLTRESİ VE ALT KLASÖR BYPASS
const groupIndices = allEntries.filter(entry => entry.id.startsWith("tr/") && entry.id.includes("-index"));
---

<CollectionLayout entries={groupIndices} collectionIndex={collectionIndex} />