---
import EntryLayout from "@components/terms/EntryLayout.astro";
import { getCollection } from "astro:content";
import type { TermsEntry } from "@/types";

const allEntries = await getCollection("terms");

// Sadece Türkçe (tr-index) dosyasını çekiyoruz
const entry = allEntries.find(e => e.id === "tr-index");
---

<EntryLayout entry={entry} />