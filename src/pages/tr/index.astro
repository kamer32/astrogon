---
import { getCollection } from "astro:content";
import EntryLayout from "@components/home/EntryLayout.astro";

const allHome = await getCollection("home");

// Verilere göre tam ID eşleşmesi (tr) kullanılmalı.
const entry = allHome.find((e) => e.id === "tr") || allHome.find((e) => e.id === "tr/index");
---
<EntryLayout entry={entry} />