---
import BaseLayout from "@components/base/BaseLayout.astro";
import { markdownify } from "@lib/textConverter";
import Button from "@components/common/Button.astro";
import type { HomeEntry } from "@/types";
import { Image } from "astro:assets";

interface Props {
  entry: HomeEntry;
}

const { entry } = Astro.props;

// --- HATA KALKANI ---
// Eğer entry gelmezse boş bir obje oluşturur, böylece .data okuması çökmez.
const entryData = entry?.data || {
  title: "Yükleniyor...",
  content: "",
  image: null,
  imageAlt: "",
  button: null
};

const { image, imageAlt, title, content, button } = entryData;
---

<BaseLayout>
  {/* Eğer veri yoksa kullanıcıya boş ekran yerine bir uyarı veya yükleniyor mesajı gösterilir */}
  {entry ? (
    <section class="section">
      <div class="container">
        <div class="row justify-center">
          <div class="text-center lg:col-6">
            {image && (
              <div class="blur-[0px] flex justify-center">
                <Image
                  class="mb-6 w-64"
                  src={image}
                  alt={imageAlt || "Beat Taurus"}
                  width={1024}
                  height={1024}
                  loading="eager"
                />
              </div>
            )}
            <h1 set:html={markdownify(title)} class="mb-4" />
            <p set:html={markdownify(content)} class="mb-8" />
            {button && (
              <Button
                label={button.label}
                link={button.link}
                newtab
                hoverInvert
                color=""
              />
            )}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <div class="text-center py-20 text-red-500">
      Veri bulunamadı. Lütfen içerik dosyalarını kontrol edin.
    </div>
  )}
</BaseLayout>