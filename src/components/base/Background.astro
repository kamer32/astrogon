<style is:global>
  /* "is:global" direktifi CSS'in tüm sayfaya uygulanmasını sağlar */
  
  html::before {
    content: "";
    position: fixed;
    top: 0; 
    left: 0;
    width: 100%;
    height: 100%;
    /* ÖNEMLİ: Dosya yolunun başına ../ ekleyerek assets klasörüne çıkıyoruz */
    background-image: url('../../assets/backgrounds/beat-taurus-bg.png'); 
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    z-index: -1;
    pointer-events: none;
  }

  /* Eğer gece modu için farklı bir resmin yoksa, dark modda resmi biraz karartalım */
  html.dark::before {
    filter: brightness(0.4) contrast(1.2);
    /* Eğer elinde beat-taurus-bg-night.png varsa aşağıdaki satırı aktif et: */
    /* background-image: url('../../assets/backgrounds/beat-taurus-bg-night.png'); */
  }
</style>